# ==============================================================================
# Extreme Weather System - Environment Variables Configuration
# Copy this file to .env or export the variables in your execution environment
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL and PostGIS Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=extreme_weather_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/extreme_weather_db

# Security & JWT Token Configuration (Must be at least 256 bits / 32 characters in base64/hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Weather API Integration (Open-Meteo or custom official provider)
WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=
MOCK_WEATHER_FALLBACK=true

# Notification Integration (Firebase Cloud Messaging & SMS)
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=
FCM_MOCK_MODE=true

SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_MOCK_MODE=true
